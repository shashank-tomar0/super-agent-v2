# VLEE Server Configuration
# Copy this to .env and fill in your keys.

# Server port
PORT=3001

# VLM Provider: "anthropic" | "openai" | "openrouter"
VLM_PROVIDER=anthropic

# VLM Model: depends on provider
# Anthropic: claude-sonnet-5, claude-opus-5
# OpenAI: gpt-4o, gpt-4o-mini
# OpenRouter: anthropic/claude-sonnet-5, openai/gpt-4o
VLM_MODEL=claude-sonnet-5

# API Keys (only need the one for your chosen provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Development mode
NODE_ENV=development
